# pi-cloud sshd hardening: key-only, root with key, no PAM/empty passwords.
# Host key comes from the SEALED secret (entrypoint copies it to /root/.ssh at
# boot) — never the image-baked keys, which rotate on every image rebuild.
HostKey /root/.ssh/ssh_host_ed25519_key

Port 22
ListenAddress 0.0.0.0

PermitRootLogin prohibit-password
PubkeyAuthentication yes
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitEmptyPasswords no
ChallengeResponseAuthentication no
UsePAM no

# Single authorized_keys source
AuthorizedKeysFile .ssh/authorized_keys

# Keep session alive over flaky mobile networks
ClientAliveInterval 30
ClientAliveCountMax 6
TCPKeepAlive yes

# Hardening
PermitUserEnvironment no
X11Forwarding no
AllowAgentForwarding yes
AllowTcpForwarding yes
MaxAuthTries 4
LoginGraceTime 30
LogLevel VERBOSE

# NOTE: no Subsystem directive here — Debian's /etc/ssh/sshd_config already
# defines `Subsystem sftp`, and a second definition is a fatal config error.